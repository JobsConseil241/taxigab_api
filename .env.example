APP_NAME="Taxi Gab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Libreville
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=taxigab
DB_USERNAME=taxigab
DB_PASSWORD=taxigab_pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=taxigab

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@taxigab.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Reverb
REVERB_APP_ID=taxigab
REVERB_APP_KEY=taxigab-key
REVERB_APP_SECRET=taxigab-secret
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST="127.0.0.1"
REVERB_SERVER_PORT=8080

# Google Maps
GOOGLE_MAPS_API_KEY=
GOOGLE_DIRECTIONS_API_KEY=

# Taxi Gab — Pricing overrides
TAXIGAB_BASE_FARE=500
TAXIGAB_PER_KM=350
TAXIGAB_PER_MIN_WAIT=50
TAXIGAB_MIN_FARE=1000
TAXIGAB_CURRENCY=XAF
TAXIGAB_MATCH_RADIUS_KM=10
